      "Bash(C:\\Users\\FlowUP\\noa\\bin\\noa-agent.cmd:*)"
    ]
  },
  "model": "opus",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "WebSearch|WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "C:/PROGRA~1/Git/bin/bash.exe C:/Users/FlowUP/.claude/hooks/web-research-gate.sh"
          }
        ]
      },
      {
